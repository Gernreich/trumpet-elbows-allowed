{"commands":[
{"command":"parameters.add","params":{"name":"bore","expression":"10 mm","comment":"the bore the bell meets, square"}},
{"command":"parameters.add","params":{"name":"length","expression":"152 mm","comment":"the horn's length, throat to rim, on the profile"}},
{"command":"parameters.add","params":{"name":"mouth","expression":"80 mm","comment":"the mouth: the rim's diameter if it were round of the same area"}},
{"command":"parameters.add","params":{"name":"gamma","expression":"0.7","unit":"","comment":"the Bessel horn's flare"}},
{"command":"parameters.add","params":{"name":"lap","expression":"3 mm","comment":"how far each ring seats on the one below, per side"}},
{"command":"parameters.add","params":{"name":"overhang","expression":"3 mm","comment":"the flange past the bore's outside"}},
{"command":"parameters.add","params":{"name":"ply","expression":"3 mm","comment":"the ply: each lamination's rise, and the bore's walls"}},
{"command":"parameters.add","params":{"name":"min_wall","expression":"2 mm","comment":"the thinnest a ring's wall may be, flats and corners alike"}},
{"command":"parameters.add","params":{"name":"plies","expression":"3","unit":"","comment":"laminations a ring; the rings are numbered and placed as the default build's"}},
{"command":"parameters.add","params":{"name":"B_","expression":"bore/(1 mm)","unit":"","comment":"read only"}},
{"command":"parameters.add","params":{"name":"L_","expression":"length/(1 mm)","unit":"","comment":"read only"}},
{"command":"parameters.add","params":{"name":"RT_","expression":"B_/2","unit":"","comment":"read only"}},
{"command":"parameters.add","params":{"name":"RIM_","expression":"mouth/(1 mm)/2*sqrt(pi)/2","unit":"","comment":"read only"}},
{"command":"parameters.add","params":{"name":"U0_","expression":"L_/((RIM_/RT_)^(1/gamma) - 1)","unit":"","comment":"read only"}},
{"command":"parameters.add","params":{"name":"BB_","expression":"RT_*(L_ + U0_)^gamma","unit":"","comment":"read only"}},
{"command":"parameters.add","params":{"name":"STEP_","expression":"plies*ply/(1 mm)","unit":"","comment":"read only"}},
{"command":"parameters.add","params":{"name":"LAP_","expression":"lap/(1 mm)","unit":"","comment":"read only"}},
{"command":"parameters.add","params":{"name":"MW_","expression":"min_wall/(1 mm)","unit":"","comment":"read only"}},
{"command":"parameters.add","params":{"name":"r_0","expression":"RT_","unit":"","comment":"read only"}},
{"command":"parameters.add","params":{"name":"h_0","expression":"RT_","unit":"","comment":"read only"}},
{"command":"parameters.add","params":{"name":"c_0","expression":"0","unit":"","comment":"read only"}},
{"command":"parameters.add","params":{"name":"r_1","expression":"r_0 + max(BB_*((L_ - (min(1*STEP_, L_))) + U0_)^(-gamma) - BB_*((L_ - (min(0*STEP_, L_))) + U0_)^(-gamma), MW_ - LAP_)","unit":"","comment":"read only"}},
{"command":"parameters.add","params":{"name":"t_1","expression":"min(1*STEP_, L_)/L_","unit":"","comment":"read only"}},
{"command":"parameters.add","params":{"name":"h_1","expression":"max(max(r_1*2/sqrt(4 - (4 - pi)*t_1^2), h_0 + MW_ - LAP_), (MW_ - LAP_ + ((h_0 - c_0)*sqrt(2) + c_0))/((1 - t_1)*sqrt(2) + t_1))","unit":"","comment":"read only"}},
{"command":"parameters.add","params":{"name":"c_1","expression":"t_1*h_1","unit":"","comment":"read only"}},
{"command":"parameters.add","params":{"name":"r_2","expression":"r_1 + max(BB_*((L_ - (min(2*STEP_, L_))) + U0_)^(-gamma) - BB_*((L_ - (min(1*STEP_, L_))) + U0_)^(-gamma), MW_ - LAP_)","unit":"","comment":"read only"}},
{"command":"parameters.add","params":{"name":"t_2","expression":"min(2*STEP_, L_)/L_","unit":"","comment":"read only"}},
{"command":"parameters.add","params":{"name":"h_2","expression":"max(max(r_2*2/sqrt(4 - (4 - pi)*t_2^2), h_1 + MW_ - LAP_), (MW_ - LAP_ + ((h_1 - c_1)*sqrt(2) + c_1))/((1 - t_2)*sqrt(2) + t_2))","unit":"","comment":"read only"}},
{"command":"parameters.add","params":{"name":"c_2","expression":"t_2*h_2","unit":"","comment":"read only"}},
{"command":"parameters.add","params":{"name":"r_3","expression":"r_2 + max(BB_*((L_ - (min(3*STEP_, L_))) + U0_)^(-gamma) - BB_*((L_ - (min(2*STEP_, L_))) + U0_)^(-gamma), MW_ - LAP_)","unit":"","comment":"read only"}},
{"command":"parameters.add","params":{"name":"t_3","expression":"min(3*STEP_, L_)/L_","unit":"","comment":"read only"}},
{"command":"parameters.add","params":{"name":"h_3","expression":"max(max(r_3*2/sqrt(4 - (4 - pi)*t_3^2), h_2 + MW_ - LAP_), (MW_ - LAP_ + ((h_2 - c_2)*sqrt(2) + c_2))/((1 - t_3)*sqrt(2) + t_3))","unit":"","comment":"read only"}},
{"command":"parameters.add","params":{"name":"c_3","expression":"t_3*h_3","unit":"","comment":"read only"}},
{"command":"parameters.add","params":{"name":"r_4","expression":"r_3 + max(BB_*((L_ - (min(4*STEP_, L_))) + U0_)^(-gamma) - BB_*((L_ - (min(3*STEP_, L_))) + U0_)^(-gamma), MW_ - LAP_)","unit":"","comment":"read only"}},
