# How every shipped SVG under parts/mouthpiece is drawn. Checked by
# lasermade-tools' repro-svg; $OUT is where the file must be written.
# The reasoning is in ../bell/.repro: these generators were run by no gate at
# all, and they write to disk when run.

cut-files/mouthpiece-bore10-trumpet-parts-cut-files.svg :: ../../target/release/mouthpiece-round $OUT

# The view is the mouthpiece's own, because bell-view.rs draws square section
# and would render these round rings as squares. The section is bell-section.rs,
# which is read by the mouthpiece too -- which is why its output path is derived
# from the SOURCE file rather than from the script, or a mouthpiece drawing ends
# up filed under bell/.
mouthpiece-bore10-trumpet-parts-view.svg :: ../../target/release/mouthpiece-view $OUT
mouthpiece-bore10-trumpet-parts-section.svg :: ../../target/release/bell-section cut-files/mouthpiece-bore10-trumpet-parts-cut-files.svg $OUT

# The turn page, drawn by the shared part-view.rs rather than a mouthpiece one.
# See ../bell/.repro for why a page needs claiming here at all.
mouthpiece-bore10-trumpet-parts-turn.html :: ../../target/release/part-view cut-files/mouthpiece-bore10-trumpet-parts-cut-files.svg $OUT
